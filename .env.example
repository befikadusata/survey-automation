# Postgres Database
POSTGRES_PASSWORD=your_secure_password

# n8n
N8N_USER=admin
N8N_PASSWORD=your_secure_password

# Domain & Webhooks
DOMAIN=localhost
WEBHOOK_SECRET=your_shared_webhook_secret # Deprecated: use service-specific secrets below
BREVO_WEBHOOK_SECRET=your_brevo_webhook_secret
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret
QUALTRICS_WEBHOOK_SECRET=your_qualtrics_webhook_secret

# Brevo (Sendinblue)
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=surveys@yourdomain.com
BREVO_SENDER_NAME=Research Team
BREVO_INVITATION_TEMPLATE_ID=1
BREVO_REMINDER_TEMPLATE_ID=2

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_key
NEXTAUTH_URL=https://localhost

# Admin credentials (single-user login)
ADMIN_USER=admin
ADMIN_PASSWORD=your_admin_password
