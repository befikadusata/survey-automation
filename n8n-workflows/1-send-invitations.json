{
  "name": "1. Send Invitations",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-invitations",
        "options": {}
      },
      "id": "1",
      "name": "Webhook (Trigger)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [ 250, 300 ],
      "webhookId": "send-invitations"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.id, r.survey_id, r.email, r.first_name, r.token, s.title as survey_title\nFROM respondents r\nJOIN surveys s ON s.id = r.survey_id\nWHERE r.survey_id = $1 AND r.status = 'pending';",
        "additionalFields": {
          "queryParams": "={{ $json.body.survey_id }}"
        }
      },
      "id": "2",
      "name": "Postgres (Get Pending)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [ 450, 300 ],
      "credentials": {
        "postgres": { "id": "postgres", "name": "Postgres" }
      }
    },
    {
      "parameters": { "batchSize": 500, "options": {} },
      "id": "3",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [ 650, 300 ]
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "sendTemplate",
        "templateId": "={{ $env.BREVO_INVITATION_TEMPLATE_ID }}",
        "recipientEmail": "={{ $json.email }}",
        "recipientName": "={{ $json.first_name || '' }}",
        "additionalFields": {
          "params": {
            "first_name": "={{ $json.first_name }}",
            "survey_title": "={{ $json.survey_title }}",
            "tracking_url": "={{ $env.NEXTAUTH_URL }}/r/{{ $json.token }}"
          }
        }
      },
      "id": "4",
      "name": "Brevo (Send Email)",
      "type": "n8n-nodes-base.brevo",
      "typeVersion": 1,
      "position": [ 850, 300 ],
      "credentials": {
        "brevoApi": { "id": "brevo", "name": "Brevo API" }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.messageId }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "8",
      "name": "If (Success?)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 1050, 300 ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO webhook_mappings (message_id, respondent_id, survey_id, email)\nVALUES ($1, $2, $3, $4)\nON CONFLICT (message_id) DO NOTHING;",
        "additionalFields": {
          "queryParams": "={{ $json.messageId }},{{ $json.id }},{{ $json.survey_id }},{{ $json.email }}"
        }
      },
      "id": "7",
      "name": "Postgres (Store Mapping)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [ 1250, 200 ],
      "credentials": {
        "postgres": { "id": "postgres", "name": "Postgres" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE respondents SET status = 'invited', invited_at = NOW() WHERE id = $1;\nINSERT INTO events (respondent_id, survey_id, event_type, source) VALUES ($1, $2, 'invited', 'n8n');",
        "additionalFields": {
          "queryParams": "={{ $json.id }},{{ $json.survey_id }}"
        }
      },
      "id": "5",
      "name": "Postgres (Update Status)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [ 1450, 200 ],
      "credentials": {
        "postgres": { "id": "postgres", "name": "Postgres" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO events (respondent_id, survey_id, event_type, source, metadata) \nVALUES ($1, $2, 'invitation_failed', 'n8n', $3);",
        "additionalFields": {
          "queryParams": "={{ $json.id }},{{ $json.survey_id }},{{ JSON.stringify($json.error || { message: 'Unknown error' }) }}"
        }
      },
      "id": "9",
      "name": "Postgres (Log Failure)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [ 1250, 450 ],
      "credentials": {
        "postgres": { "id": "postgres", "name": "Postgres" }
      }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "{\"ok\": true, \"sent\": {{$runIndex}} }", "options": {} },
      "id": "6",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [ 650, 500 ]
    }
  ],
  "connections": {
    "Webhook (Trigger)": {
      "main": [ [ { "node": "Postgres (Get Pending)", "type": "main", "index": 0 } ] ]
    },
    "Postgres (Get Pending)": {
      "main": [ [ { "node": "Split In Batches", "type": "main", "index": 0 }, { "node": "Respond to Webhook", "type": "main", "index": 0 } ] ]
    },
    "Split In Batches": {
      "main": [ [ { "node": "Brevo (Send Email)", "type": "main", "index": 0 } ] ]
    },
    "Brevo (Send Email)": {
      "main": [ [ { "node": "If (Success?)", "type": "main", "index": 0 } ] ]
    },
    "If (Success?)": {
      "main": [
        [ { "node": "Postgres (Store Mapping)", "type": "main", "index": 0 } ],
        [ { "node": "Postgres (Log Failure)", "type": "main", "index": 0 } ]
      ]
    },
    "Postgres (Store Mapping)": {
      "main": [ [ { "node": "Postgres (Update Status)", "type": "main", "index": 0 } ] ]
    },
    "Postgres (Update Status)": {
      "main": [ [ { "node": "Split In Batches", "type": "main", "index": 0 } ] ]
    },
    "Postgres (Log Failure)": {
      "main": [ [ { "node": "Split In Batches", "type": "main", "index": 0 } ] ]
    }
  },
  "active": false,
  "settings": {}
}
